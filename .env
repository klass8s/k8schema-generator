###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=''
###< symfony/framework-bundle ###

###> knplabs/github-api ###
GITHUB_AUTH_METHOD=http_password
GITHUB_USERNAME=username
GITHUB_SECRET=password_or_token
###< knplabs/github-api ###

# This json schema versions then can be used to retrieve the latest json schema for some minor Kubernetes version. For example the latest json schema version for Kubernetes v1.31 is v1.31.14
K8S_JSON_SCHEMA_VERSIONS='{"v1.31":"v1.31.14","v1.32":"v1.32.11","v1.33":"v1.33.7","v1.34":"v1.34.3","v1.35":"v1.35.0"}'
